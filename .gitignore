/*

# Source, schema, tooling scripts
!/src
!/public
!/db
!/hack

# Build and toolchain config
!/justfile
!/package.json
!/package-lock.json
!/tsconfig.json
!/next.config.ts
!/postcss.config.mjs
!/eslint.config.mjs

# Docs and meta
!/.gitignore
!/README.md
!/CLAUDE.md
!/todo.txt

# Junk that can turn up anywhere inside the directories above. Deliberately
# unanchored — these need to match at any depth, not just the root.
.DS_Store
*.pem
*.tsbuildinfo
