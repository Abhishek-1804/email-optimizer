# Copy to .env.local and fill in. .env.local is gitignored; this file is the
# only env file that should ever be committed.

# --- Clerk (sign-in only; knows nothing about mailboxes) -----------------
# From https://dashboard.clerk.com -> your app -> API keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk route config. These values work as-is.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# --- Google OAuth (mailbox access; separate grant from sign-in) ----------
# Your own Google Cloud OAuth client — see README "Google OAuth setup".
# Requires scope https://mail.google.com/ and the redirect URI
# http://localhost:3000/api/mailboxes/callback registered in the console.
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...

# --- Local storage --------------------------------------------------------
# 32 random bytes, base64. Encrypts Google refresh tokens at rest. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing this later strands every stored token — mailboxes must reconnect.
TOKEN_ENCRYPTION_KEY=
